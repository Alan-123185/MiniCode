# ============================================
# MiniCodex Sandbox Image
# 用途：为 execute_command 提供隔离的 Linux 执行环境
# 优化：全面适配国内网络环境，无需配置代理即可极速构建
# ============================================

# 1. 使用 DaoCloud 镜像加速，并强制锁定 Debian 12 (bookworm) 稳定版
# 完美避开 Debian 13 (trixie) 测试版国内源缺包报 404 的问题
FROM docker.m.daocloud.io/python:3.12-slim-bookworm

# 避免 apt 交互式提示（如 tzdata）
ENV DEBIAN_FRONTEND=noninteractive

# 2. 全局配置国内镜像源 (使用环境变量，对所有用户生效，比改配置文件更优雅)
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# ---- 第一层：替换系统源 & 安装基础工具 ----
# 使用中科大 (USTC) 镜像源，对 bookworm 支持完美，国内直连极快
RUN echo 'deb http://mirrors.ustc.edu.cn/debian/ bookworm main contrib non-free non-free-firmware' > /etc/apt/sources.list && \
    echo 'deb http://mirrors.ustc.edu.cn/debian/ bookworm-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list && \
    echo 'deb http://mirrors.ustc.edu.cn/debian-security/ bookworm-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    ripgrep \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ---- 第二层：Node.js LTS (22.x) ----
# 【核心修改】：放弃极易超时的 NodeSource 官方 apt 仓库
# 改用淘宝 npmmirror 提供的预编译二进制包，国内下载秒级完成，无需 gnupg
ENV NODE_VERSION=22.9.0
RUN curl -fsSL https://cdn.npmmirror.com/binaries/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz -o node.tar.xz \
    && tar -xJf node.tar.xz -C /usr/local --strip-components=1 \
    && rm node.tar.xz

# ---- 第三层：创建非 root 用户 & 工作目录 ----
RUN useradd -m -s /bin/bash agent \
    && mkdir -p /workspace \
    && chown -R agent:agent /workspace

# 切换到非 root 用户
USER agent
WORKDIR /workspace

# 保持容器长驻（实际命令通过 docker exec 注入）
CMD ["sleep", "infinity"]