# ---------- Docker 沙箱（阶段2新增，可选） ----------
# 总开关：True=execute_command 在 Docker 容器内执行（需先构建沙箱镜像：
#   docker build -f Dockerfile.sandbox -t minicodex-sandbox:latest .）
# False=维持原有宿主机直接执行行为
SANDBOX_ENABLED = False
SANDBOX_IMAGE = "minicodex-sandbox:latest"
SANDBOX_WORKDIR = "/workspace"
SANDBOX_MEM_LIMIT = "1g"
SANDBOX_CPU_COUNT = 2.0
SANDBOX_NETWORK_ENABLED = True
SANDBOX_IDLE_TTL_MINUTES = 120

