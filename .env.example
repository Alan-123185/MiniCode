DEFAULT_BASE_URL = "your_default_base_url_here"

DEFAULT_API_KEY = "your_default_api_key_here"

DEFAULT_MODEL = "your_default_model_here"

baidu_search_url = "your_baidu_search_url_here"

baidu_search_api_key  = "your_baidu_search_api_key_here"

# ---------- Docker 沙箱（阶段2新增，可选） ----------
# 总开关：True=execute_command 在 Docker 容器内执行（需先构建沙箱镜像：
#   docker build -f Dockerfile.sandbox -t minicodex-sandbox:latest .）
# False=维持原有宿主机直接执行行为
SANDBOX_ENABLED = False
SANDBOX_IMAGE = "minicodex-sandbox:latest"
SANDBOX_WORKDIR = "/workspace"
SANDBOX_MEM_LIMIT = "1g"
SANDBOX_CPU_COUNT = 2.0
SANDBOX_NETWORK_ENABLED = True
SANDBOX_IDLE_TTL_MINUTES = 120

# MiniMemo MCP。填写项目路径和同一个 Agent 的三个标识即可启用。
 MINIMEMO_PROJECT_DIR = D:/IDEA文件/Python文件/MiniMemo
 MINIMEMO_API_URL = http://127.0.0.1:1314
 MINIMEMO_USER_ID = your_user_id
 MINIMEMO_AGENT_NAME = your_agent_name
 MINIMEMO_AGENT_ID = your_agent_internal_id

